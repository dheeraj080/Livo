# ==============================================================================
# livo Self-Hosted Configuration (.env)
# ==============================================================================
# Copy this file to .env before starting the Docker Compose stack:
# cp .env.example .env

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# [Optional] Runtime environment mode (production, development, test)
NODE_ENV=production

# [Optional] External host port to expose livo (default: 3000)
PORT=3000

# [Optional] Public URL of the application
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# [Required for Docker Compose PostgreSQL service]
POSTGRES_DB=livo
POSTGRES_USER=livo
POSTGRES_PASSWORD=livo_password

# [Required] PostgreSQL connection string used by livo application and Drizzle ORM
# For Docker Compose (default internal network connection):
DATABASE_URL=postgresql://livo:livo_password@postgres:5432/livo
# For local host development outside Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livo

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
# [Required for BullMQ background queues and workers]
# For Docker Compose (default internal network connection):
REDIS_URL=redis://redis:6379
# For local host development outside Docker:
# REDIS_URL=redis://localhost:6379

# Alternative individual Redis connection parameters (optional, used if REDIS_URL not set):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Elasticsearch
# ------------------------------------------------------------------------------
# [Required for full-text and semantic search indexing]
# For Docker Compose (default internal network connection):
ELASTICSEARCH_NODE=http://elasticsearch:9200
# For local host development outside Docker:
# ELASTICSEARCH_NODE=http://localhost:9200

# [Optional] Elasticsearch authentication (if using secured cluster or Elastic Cloud)
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ------------------------------------------------------------------------------
# Object Storage
# ------------------------------------------------------------------------------
# [Required for Docker Compose MinIO service credentials]
MINIO_ROOT_USER=livo
MINIO_ROOT_PASSWORD=livo_secret_key
# [Optional] Host port for MinIO Web Console dashboard (default: 9001)
MINIO_CONSOLE_PORT=9001

# S3 Client Configuration used by livo storage service:
# [Required for S3-compatible storage like MinIO]
S3_ENDPOINT=http://minio:9000
# [Optional] S3 Region (default: us-east-1)
S3_REGION=us-east-1
# [Required] S3 Access Key ID (matches MINIO_ROOT_USER in Compose)
S3_ACCESS_KEY=livo
# [Required] S3 Secret Access Key (matches MINIO_ROOT_PASSWORD in Compose)
S3_SECRET_KEY=livo_secret_key
# [Optional] Target S3 bucket name for attachments (default: livo-attachments)
S3_BUCKET=livo-attachments
# [Required for MinIO] Force path style access (true for MinIO, false for AWS S3)
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# AI
# ------------------------------------------------------------------------------
# [Optional] Google Gemini API Key
# Enables AI note summarization, title generation, automated tagging, and Q&A.
# livo starts and functions completely without an API key if AI is not needed.
# Obtain an API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# livo resolves user identity via reverse-proxy HTTP headers:
# - 'x-user-email': Authenticated user's email address
# - 'x-user-name': Authenticated user's display name
# - 'x-user-id': (Optional) Specific user UUID
# When running behind an authenticating reverse proxy (Authelia, Cloudflare Access,
# Tailscale, or Traefik ForwardAuth), pass these headers.
# If no headers are provided, livo uses the default local profile.

