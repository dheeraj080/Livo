# ==============================================================================
# Nimbus Self-Hosted Configuration (.env)
# ==============================================================================
# Copy this file to .env before starting the Docker Compose stack:
# cp .env.example .env

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Primary Storage)
# ------------------------------------------------------------------------------
# PostgreSQL container credentials:
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus_password

# Database connection URL:
# For Docker Compose (default internal network connection):
DATABASE_URL=postgresql://nimbus:nimbus_password@postgres:5432/nimbus
# For local development outside Docker, use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nimbus

# ------------------------------------------------------------------------------
# Redis (BullMQ Queues and Background Workers)
# ------------------------------------------------------------------------------
# For Docker Compose:
REDIS_URL=redis://redis:6379
# For local development outside Docker, use:
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Elasticsearch (Search Indexing and Dense Vector Embeddings)
# ------------------------------------------------------------------------------
# For Docker Compose:
ELASTICSEARCH_NODE=http://elasticsearch:9200
# For local development outside Docker, use:
# ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage (Document Attachments)
# ------------------------------------------------------------------------------
# MinIO root credentials:
MINIO_ROOT_USER=nimbus
MINIO_ROOT_PASSWORD=nimbus_secret_key
MINIO_CONSOLE_PORT=9001

# S3 Client Configuration:
# For Docker Compose:
S3_ENDPOINT=http://minio:9000
# For local development outside Docker, use:
# S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nimbus
S3_SECRET_KEY=nimbus_secret_key
S3_BUCKET=nimbus-attachments
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# Google Gemini AI
# ------------------------------------------------------------------------------
# Required for note summarization, title generation, automated tagging, and Q&A.
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
